---
import { Image } from 'astro:assets';
import Button from '../components/Buttons.astro';
import AboutImage from '../assets/share-gab.png';
---

<section id="about" class="about pt-section">
  <div class="container">
    <div class="grid">
      <div class="about__content">
        <h2>About me</h2>
        <p>
          Hi, I’m Sharine Gabriella. A business analyst with a data and analytics edge, backed with an experiences across regulated institutions and digital business analysis. Experienced in requirements documentation (BRS), UAT, process gap analysis, and turning data into clear reporting for stakeholders. Also run large-scale event operations (1000+ participants), showing strong coordination and execution in fast-moving, cross-functional settings.
        </p>
      </div>

      <div class="about__image">
        <Image
        class="about__img" 
        src={AboutImage} 
        alt="About Image" 
        width={600}
        />
      </div>
    </div>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 1rem;
  }

  .about__content {
    margin-bottom: 2rem;
    text-align: center;
  }

  .about__content p {
    margin-bottom: 2rem;
  }

  .about__image {
    position: relative;
  }

  .about__image::before {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: -0.5rem;
    width: 25px;
    height: 100px;
    border: 1.5px solid var(--primary-clr-400);
    border-radius: 5rem;
  }

  .about__image::after {
    content: '';
    position: absolute;
    top: -2.5rem;
    right: 2rem;
    width: 20px;
    height: 80px;
    border: 1.5px solid var(--primary-clr-400);
    border-radius: 5rem;
    rotate: 90deg;
  }

  .about__image {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .about__img {
    width: min(100%, 450px);
    height:auto;
    border-radius: 0.5rem;
  }

  @media (min-width: 768px) {
    h2 {
      text-align: left;
    }

    .about__content {
      text-align: left;
    }

    .about__content p {
      font-size: 1.1rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 4rem;
      place-items: center;
    }
  }
</style>